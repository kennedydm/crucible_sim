	keywords = {Visualization, Evolutionary computation, Design optimization, Laboratories, System testing, Computer networks, Mechanical engineering, Optimal control, Scalability, Shape control},
	pages = {825--830 vol.1},
	file = {Full Text PDF:C\:\\Users\\dktow\\Zotero\\storage\\2M2PQK2A\\Deb et al. - 2002 - Scalable multi-objective optimization test problems.pdf:application/pdf},
}

