	keywords = {Optimization, Metaheuristics, Survey, Hyper-heuristics},
	pages = {109815},
	file = {PDF:C\:\\Users\\dktow\\Zotero\\storage\\RNQGVWME\\Dokeroglu et al. - 2024 - Hyper-heuristics A survey and taxonomy.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\dktow\\Zotero\\storage\\AZ7KPRRY\\S0360835223008392.html:text/html},
